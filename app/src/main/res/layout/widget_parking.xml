<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:paddingStart="14dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- 글자 묶음. 남는 가로 폭을 전부 차지해서 차 그림을 오른쪽 끝으로 민다. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_spot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="기록 없음"
            android:textColor="#F0E7C6"
            android:textSize="22sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_ago"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="눌러서 기록하기"
            android:textColor="#99F0E7C6"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 코식이 차. 폭을 41dp 로 묶어 두면 높이가 46dp 로 잡힌다.
         위젯을 작게 줄이면 fitCenter 가 알아서 더 작게 그린다. -->
    <ImageView
        android:id="@+id/widget_car"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:adjustViewBounds="true"
        android:maxWidth="41dp"
        android:scaleType="fitCenter"
        android:src="@drawable/kosiki_car"
        android:contentDescription="@string/car_desc" />

</LinearLayout>
